# Template des variables d'environnement
# Copier et adapter selon votre environnement
# ⚠️ NE PAS COMMITER les fichiers .env réels

VITE_APP_ENV=development
VITE_APP_API_URL=http://localhost:3000
VITE_APP_API_TIMEOUT=30000
VITE_APP_DEBUG_MODE=true
VITE_APP_LOG_LEVEL=verbose
VITE_APP_SHOW_DEV_TOOLS=true
VITE_APP_VERSION=1.0.0-dev.1
VITE_APP_BUILD_DATE=2026-09-05T00:00:00Z
VITE_APP_LICENSE_REQUIRED=false
VITE_APP_LICENSE_TEST_KEYS=
VITE_APP_SHOW_DUMMY_DATA=true
VITE_APP_APP_ID=com.chantier.chantier_pro.dev
VITE_APP_PRIVACY_POLICY_URL=https://chantier.app/legal/privacy
VITE_APP_TERMS_URL=https://chantier.app/legal/terms
