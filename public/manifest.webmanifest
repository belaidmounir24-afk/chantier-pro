{
  "name": "ChantierPro — Gestion de Chantier BTP",
  "short_name": "ChantierPro",
  "description": "Application professionnelle mobile de gestion de chantier : pointage journalier, suivi du personnel, acomptes, stocks matériaux, engins et journal de bord.",
  "id": "com.chantierpro.btp.app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "fr",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Pointage Chantier",
      "short_name": "Pointage",
      "description": "Accéder directement à la grille de pointage",
      "url": "/?tab=dash",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Personnel & Paie",
      "short_name": "Personnel",
      "description": "Gérer les ouvriers et leurs acomptes",
      "url": "/?tab=team",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Matériaux & Engins",
      "short_name": "Matériaux",
      "description": "Suivi des bons de livraison et parc matériel",
      "url": "/?tab=mat",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Journal de Chantier",
      "short_name": "Journal",
      "description": "Rédiger le rapport quotidien du chantier",
      "url": "/?tab=log",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    }
  ]
}
